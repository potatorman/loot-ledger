rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function roomIsMember(roomId) {
      let room = get(/databases/$(database)/documents/rooms/$(roomId)).data;
      return signedIn() &&
        (room.ownerUid == request.auth.uid || room.secondMemberUid == request.auth.uid);
    }

    function roomIsOwner(roomId) {
      return signedIn() &&
        get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerUid == request.auth.uid;
    }

    match /rooms/{roomId} {
      // The room creator is member one; the random invite key is 192 bits.
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.secondMemberUid == null
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.size() >= 32
        && request.resource.data.name is string;

      allow get: if signedIn() &&
        (resource.data.ownerUid == request.auth.uid || resource.data.secondMemberUid == request.auth.uid);
      allow list: if false;

      allow update: if signedIn() && (
        // A friend can claim the empty second slot only with the current invite key.
        (
          resource.data.secondMemberUid == null
          && request.auth.uid != resource.data.ownerUid
          && request.resource.data.secondMemberUid == request.auth.uid
          && request.resource.data.joinProof == resource.data.inviteCode
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.inviteCode == resource.data.inviteCode
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['secondMemberUid', 'joinProof', 'joinedAt'])
        ) ||
        // Only the owner can kick the second member. The invite key must rotate so
        // a kicked person cannot use the old invite link to rejoin.
        (
          resource.data.ownerUid == request.auth.uid
          && resource.data.secondMemberUid is string
          && request.resource.data.secondMemberUid == null
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.inviteCode is string
          && request.resource.data.inviteCode.size() >= 32
          && request.resource.data.inviteCode != resource.data.inviteCode
          && request.resource.data.kickedUid == resource.data.secondMemberUid
          && request.resource.data.kickedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['secondMemberUid', 'inviteCode', 'joinProof', 'joinedAt', 'kickedUid', 'kickedAt'])
        ) ||
        // Existing room-name edit permission.
        (
          (resource.data.ownerUid == request.auth.uid || resource.data.secondMemberUid == request.auth.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 80
        )
      );

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /shops/{shopId} {
        allow read, create, update, delete: if roomIsMember(roomId);
      }

      match /items/{itemId} {
        allow read, create, update, delete: if roomIsMember(roomId);
      }

      // A member's name and last-seen heartbeat are readable by the two room
      // members. Users can write only their own profile; only the owner can
      // remove another member's profile during a kick.
      match /members/{memberUid} {
        allow read: if roomIsMember(roomId);
        allow create, update: if roomIsMember(roomId)
          && request.auth.uid == memberUid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.nickname is string
          && request.resource.data.nickname.size() <= 28
          && request.resource.data.lastSeenAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.keys().hasOnly(['uid', 'nickname', 'lastSeenAt', 'updatedAt']);
        allow delete: if roomIsOwner(roomId);
      }
    }

    // All other documents are private by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
