rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function roomIsMember(roomId) {
      let room = get(/databases/$(database)/documents/rooms/$(roomId)).data;
      return signedIn() &&
        (room.ownerUid == request.auth.uid || room.secondMemberUid == request.auth.uid);
    }

    match /rooms/{roomId} {
      // The room creator is the first member. The secret invite key is a random 192-bit value.
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.secondMemberUid == null
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.size() >= 32
        && request.resource.data.name is string;

      allow get: if signedIn() &&
        (resource.data.ownerUid == request.auth.uid || resource.data.secondMemberUid == request.auth.uid);
      allow list: if false;

      // A friend can claim the one remaining member slot only with the invite key.
      // After that, secondMemberUid is non-null and no third member can join.
      allow update: if signedIn() && (
        (
          resource.data.secondMemberUid == null
          && request.auth.uid != resource.data.ownerUid
          && request.resource.data.secondMemberUid == request.auth.uid
          && request.resource.data.joinProof == resource.data.inviteCode
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.inviteCode == resource.data.inviteCode
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['secondMemberUid', 'joinProof', 'joinedAt'])
        ) || (
          (resource.data.ownerUid == request.auth.uid || resource.data.secondMemberUid == request.auth.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 80
        )
      );

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /shops/{shopId} {
        allow read, create, update, delete: if roomIsMember(roomId);
      }

      match /items/{itemId} {
        allow read, create, update, delete: if roomIsMember(roomId);
      }
    }

    // All other documents are private by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
