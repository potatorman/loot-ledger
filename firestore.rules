rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function roomIsMember(roomId) {
      let room = get(/databases/$(database)/documents/rooms/$(roomId)).data;
      return signedIn() &&
        (room.ownerUid == request.auth.uid || room.secondMemberUid == request.auth.uid);
    }

    function roomIsOwner(roomId) {
      return signedIn() &&
        get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerUid == request.auth.uid;
    }

    match /rooms/{roomId} {
      // New rooms have a room name, a random invite key, and a one-way password hash.
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.secondMemberUid == null
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.size() >= 32
        && request.resource.data.roomPasswordHash is string
        && request.resource.data.roomPasswordHash.size() == 64
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80;

      allow get: if signedIn() &&
        (resource.data.ownerUid == request.auth.uid || resource.data.secondMemberUid == request.auth.uid);
      allow list: if false;

      allow update: if signedIn() && (
        // A friend can claim the empty second slot using either the room password,
        // or the private invite key plus the room password (for invite links).
        (
          resource.data.secondMemberUid == null
          && request.auth.uid != resource.data.ownerUid
          && request.resource.data.secondMemberUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.inviteCode == resource.data.inviteCode
          && (
            // Password-only joining: the password hash is the join proof.
            (resource.data.roomPasswordHash is string
              && request.resource.data.joinProof == resource.data.roomPasswordHash)
            ||
            // Invite-link joining for current password-protected rooms.
            (resource.data.roomPasswordHash is string
              && request.resource.data.joinProof == resource.data.inviteCode
              && request.resource.data.passwordProof == resource.data.roomPasswordHash)
            ||
            // Backwards compatibility for older rooms created before room passwords existed.
            (!(resource.data.keys().hasAny(['roomPasswordHash']))
              && request.resource.data.joinProof == resource.data.inviteCode)
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['secondMemberUid', 'joinProof', 'passwordProof', 'joinedAt'])
        ) ||
        // Only the owner can kick the second member. Both invite key and password are rotated.
        (
          resource.data.ownerUid == request.auth.uid
          && resource.data.secondMemberUid is string
          && request.resource.data.secondMemberUid == null
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.inviteCode is string
          && request.resource.data.inviteCode.size() >= 32
          && request.resource.data.inviteCode != resource.data.inviteCode
          && request.resource.data.roomPasswordHash is string
          && request.resource.data.roomPasswordHash.size() == 64
          && (!(resource.data.keys().hasAny(['roomPasswordHash'])) || request.resource.data.roomPasswordHash != resource.data.roomPasswordHash)
          && request.resource.data.kickedUid == resource.data.secondMemberUid
          && request.resource.data.kickedAt == request.time
          && request.resource.data.passwordProof == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['secondMemberUid', 'inviteCode', 'joinProof', 'passwordProof', 'joinedAt', 'kickedUid', 'kickedAt', 'roomPasswordHash'])
        ) ||
        // Only the owner may set or rotate the room-password hash.
        (
          resource.data.ownerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roomPasswordHash'])
          && request.resource.data.roomPasswordHash is string
          && request.resource.data.roomPasswordHash.size() == 64
        ) ||
        // Existing room-name edit permission.
        (
          (resource.data.ownerUid == request.auth.uid || resource.data.secondMemberUid == request.auth.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 80
        )
      );

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /shops/{shopId} {
        allow read, create, update, delete: if roomIsMember(roomId);
      }

      match /items/{itemId} {
        allow read, create, update, delete: if roomIsMember(roomId);
      }

      match /members/{memberUid} {
        allow read: if roomIsMember(roomId);
        allow create, update: if roomIsMember(roomId)
          && request.auth.uid == memberUid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.nickname is string
          && request.resource.data.nickname.size() <= 28
          && request.resource.data.lastSeenAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.keys().hasOnly(['uid', 'nickname', 'lastSeenAt', 'updatedAt']);
        allow delete: if roomIsOwner(roomId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
